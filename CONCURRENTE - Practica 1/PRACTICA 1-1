programa PRACTICA_1_1
procesos
  proceso recorrerAvenida(E numAv: numero)
  variables
    cantFlores: numero
    cantVacias: numero
  comenzar
    cantFlores:= 0
    cantVacias:= 0
    Pos(numAv, 1)
    repetir 99
      si(HayFlorEnLaEsquina)
        mientras(HayFlorEnLaEsquina)
          tomarFlor
          cantFlores:= cantFlores + 1
      sino
        cantVacias:= cantVacias + 1   
      mover
    mientras(HayFlorEnLaBolsa)
      depositarFlor
    Informar("Flores totales ",cantFlores)
    Informar("Esquinas vacias ",cantVacias)  
  fin
areas
  ciudad: AreaC (1,1,100,100)
robots
  robot robot1
  comenzar
    recorrerAvenida(PosAv)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
comenzar
  AsignarArea(R1, ciudad)
  AsignarArea(R2, ciudad)
  AsignarArea(R3, ciudad)
  Iniciar(R1, 1,1)
  Iniciar(R2, 3,1)
  Iniciar(R3, 5,1)
fin