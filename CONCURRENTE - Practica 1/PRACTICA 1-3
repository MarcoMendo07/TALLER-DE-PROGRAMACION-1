      tomarFlor
      flores:= flores + 1        {ASI se debe contar sin modificar la esquina}
    repetir flores
      depositarFlor
  fin
  
  proceso contarPapeles(ES papeles: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      papeles:= papeles + 1  
    repetir papeles
