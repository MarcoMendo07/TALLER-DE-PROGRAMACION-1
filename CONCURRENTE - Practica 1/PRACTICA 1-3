  fin
  
  proceso escalera(E numAv: numero; E largo: numero; ES escalones: numero)
  variables
    flores: numero
    papeles: numero
  comenzar
    flores:= 0
    papeles:= 0
    repetir 2
      repetir largo
        si(HayFlorEnLaEsquina)  {PREGUNTAR: mientras HFELE tomar flor y dsp vaciar??}
