{1- Se organizó una competencia entre el equipo rojo y el equipo azul. Cada equipo consta
de dos robots, y debe realizar una tarea:
- Los robots R1 y R2 del equipo rojo debe juntar todas las flores de las avenidas 2 y 3
respectivamente
- Los robots A1 y A2 del equipo azul debe juntar todos los papeles de las calles 98 y
99 respectivamente
Al finalizar la competencia, un robot fiscalizador deberá informar el equipo que juntó más
objetos.
}

programa PRACTICA_5_1
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,R1)
    EnviarMensaje(2,R2)
    EnviarMensaje(3,A1)
    EnviarMensaje(4,A2)
  fin
  
  proceso juntarFlores(ES flores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:= flores + 1
  fin
  
  proceso juntarPapeles(ES papeles: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      papeles:= papeles + 1
  fin
  
  proceso ultimasEsquinasDeLaAvenida(ES flores: numero; E av: numero)
  comenzar
    juntarFlores(flores)
    BloquearEsquina(av,98)
    mover
    juntarFlores(flores)
    BloquearEsquina(av,99)
    mover
    LiberarEsquina(av,98)
    juntarFlores(flores)
    mover
    LiberarEsquina(av,99)
    juntarFlores(flores)
  fin
  
  proceso primerasEsquinasDeLaCalle(ES papeles: numero; E calle: numero)
  comenzar
    juntarPapeles(papeles)
    BloquearEsquina(2,calle)
    mover
    juntarPapeles(papeles)
    BloquearEsquina(3,calle)
    mover
    LiberarEsquina(2,calle)
    juntarPapeles(papeles)
    mover
    LiberarEsquina(3,calle)
  fin
  
areas
  { Fragmentación para que los inicios y finales sean 100% privados }
  avRojo1: AreaP(2,1,2,97)
  avRojo2: AreaP(3,1,3,97)
  avRojo1Fin: AreaP(2,100,2,100)
  avRojo2Fin: AreaP(3,100,3,100)
  
  calleAzul1Ini: AreaP(1,98,1,98)
  calleAzul2Ini: AreaP(1,99,1,99)
  calleAzul1: AreaP(4,98,100,98)
  calleAzul2: AreaP(4,99,100,99)
  
  { El cuadrante exacto de colisión. Convención AreaC --> asignada a todos los rob. ; sino es PC }
  areaCompartida: AreaC(2,98,3,99)
  areaFiscal: AreaP(1,1,1,1)
  
robots
  robot equipoRojo
  variables
    flores, av, id: numero
  comenzar
    flores:= 0
    av:= PosAv
    RecibirMensaje(id,fiscal)
    repetir 96
      juntarFlores(flores)
      mover
    ultimasEsquinasDeLaAvenida(flores,av)  
    EnviarMensaje(id,fiscal)
    EnviarMensaje(flores,fiscal)
  fin
  
  robot equipoAzul
  variables
    papeles, calle, id: numero
  comenzar
    papeles:= 0
    calle:= PosCa
    derecha
    RecibirMensaje(id,fiscal)
    primerasEsquinasDeLaCalle(papeles,calle)
    repetir 96
      juntarPapeles(papeles)
      mover
    juntarPapeles(papeles)  
    EnviarMensaje(id,fiscal)
    EnviarMensaje(papeles,fiscal)
  fin

  robot fiscalizador
  variables
    objetosRojo, objetosAzul, quien, cant: numero
  comenzar
    enviarIDs
    objetosRojo:= 0
    objetosAzul:= 0
    repetir 4
      RecibirMensaje(quien,*)
      si(quien = 1)
        RecibirMensaje(cant,R1)
        objetosRojo:= objetosRojo + cant
      sino
        si(quien = 2)
          RecibirMensaje(cant,R2)
          objetosRojo:= objetosRojo + cant    
        sino
          si(quien = 3)
            RecibirMensaje(cant,A1)
            objetosAzul:= objetosAzul + cant
          sino
            RecibirMensaje(cant,A2)
            objetosAzul:= objetosAzul + cant
              
    si(objetosRojo > objetosAzul)
      Informar('Gano el equipo Rojo', objetosRojo)
    sino
      si(objetosAzul > objetosRojo)
        Informar('Gano el equipo Azul', objetosAzul)
      sino
        Informar('Empate', objetosRojo)            
  fin

variables
  fiscal: fiscalizador
  R1, R2: equipoRojo
  A1, A2: equipoAzul
comenzar
  AsignarArea(fiscal, areaFiscal)
  
  AsignarArea(R1, avRojo1)
  AsignarArea(R2, avRojo2)
  AsignarArea(R1, avRojo1Fin)
  AsignarArea(R2, avRojo2Fin)
  
  AsignarArea(A1, calleAzul1Ini)
  AsignarArea(A2, calleAzul2Ini)
  AsignarArea(A1, calleAzul1)
  AsignarArea(A2, calleAzul2)
  
  AsignarArea(R1, areaCompartida)
  AsignarArea(R2, areaCompartida)
  AsignarArea(A1, areaCompartida)
  AsignarArea(A2, areaCompartida)
  
  Iniciar(fiscal, 1,1)
  Iniciar(R1, 2,1)
  Iniciar(R2, 3,1)
  Iniciar(A1, 1,98)
  Iniciar(A2, 1,99)
fin
