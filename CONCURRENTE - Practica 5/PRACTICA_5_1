programa PRACTICA_5_1
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,R1)
    EnviarMensaje(2,R2)
    EnviarMensaje(3,A1)
    EnviarMensaje(4,A2)
  fin
  
  proceso juntarFlores(ES flores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:= flores + 1
  fin
  
  proceso juntarPapeles(ES papeles: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      papeles:= papeles + 1
  fin
  
  proceso ultimasEsquinasDeLaAvenida(ES flores: numero; E av: numero)
  comenzar
    juntarFlores(flores)
    BloquearEsquina(av,98)
    mover
    juntarFlores(flores)
    BloquearEsquina(av,99)
    mover
    LiberarEsquina(av,98)
    juntarFlores(flores)
    mover
    LiberarEsquina(av,99)
    juntarFlores(flores)
  fin
  
  proceso primerasEsquinasDeLaCalle(ES papeles: numero; E calle: numero)
  comenzar
    juntarPapeles(papeles)
    BloquearEsquina(2,calle)
    mover
    juntarPapeles(papeles)
    BloquearEsquina(3,calle)
    mover
    LiberarEsquina(2,calle)
    juntarPapeles(papeles)
    mover
    LiberarEsquina(3,calle)
  fin
  
areas
  avRojo1: AreaP(2,1,2,97)
  avRojo2: AreaP(3,1,3,97)
  calleAzul1: AreaP(4,98,100,98)
  calleAzul2: AreaP(4,99,100,99)
  areaCompartida: AreaC (1,98,3,100)
  areaFiscal: AreaP(1,1,1,1)
  
robots
  robot equipoRojo
  variables
    flores: numero
    av: numero
    id: numero   {id de equipo}
  comenzar
    flores:= 0
    av:= PosAv
    RecibirMensaje(id,fiscal)
    repetir 96    {va a terminar en la 97}
      juntarFlores(flores)
      mover
    ultimasEsquinasDeLaAvenida(flores,av)  
    EnviarMensaje(id,fiscal)
    EnviarMensaje(flores,fiscal)
  fin
  
  robot equipoAzul
  variables
    papeles: numero
    calle: numero
    id: numero
  comenzar
    papeles:= 0
    calle:= PosCa
    derecha
    RecibirMensaje(id,fiscal)
    primerasEsquinasDeLaCalle(papeles,calle)
    repetir 96
      juntarPapeles(papeles)
      mover
    juntarPapeles(papeles)  
    EnviarMensaje(id,fiscal)
    EnviarMensaje(papeles,fiscal)
  fin

  robot fiscalizador
  variables
    objetosRojo: numero
    objetosAzul: numero
    quien: numero
    cant: numero
  comenzar
    enviarIDs
    objetosRojo:= 0
    objetosAzul:= 0
    repetir 4
      RecibirMensaje(quien,*)
      si(quien = 1)
        RecibirMensaje(cant,R1)
        objetosRojo:= objetosRojo + cant
      sino
        si(quien = 2)
          RecibirMensaje(cant,R2)
          objetosRojo:= objetosRojo + cant    
        sino
          si(quien = 3)
            RecibirMensaje(cant,A1)
            objetosAzul:= objetosAzul + cant
          sino {quien = 4}
            RecibirMensaje(cant,A2)
            objetosAzul:= objetosAzul + cant
    si(objetosRojo > objetosAzul)
      Informar("Gano el equipo Rojo con un total de objetos de ",objetosRojo)
    sino
      Informar("Gano el equipo Azul con un total de objetos de ",objetosAzul)            
  fin
  
variables
  fiscal: fiscalizador
  R1: equipoRojo
  R2: equipoRojo
  A1: equipoAzul
  A2: equipoAzul
comenzar
  AsignarArea(fiscal, areaFiscal)
  AsignarArea(R1, avRojo1)
  AsignarArea(R2, avRojo2)
  AsignarArea(A1, calleAzul1)
  AsignarArea(A2, calleAzul2)
  AsignarArea(R1, areaCompartida)
  AsignarArea(R2, areaCompartida)
  AsignarArea(A1, areaCompartida)
  AsignarArea(A2, areaCompartida)
  Iniciar(fiscal, 1,1)
  Iniciar(R1, 2,1)
  Iniciar(R2, 3,1)
  Iniciar(A1, 1,98)
  Iniciar(A2, 1,99)
fin