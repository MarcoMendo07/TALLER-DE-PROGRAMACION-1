programa PRACTICA_3_5
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,R1)
    EnviarMensaje(2,R2)
    EnviarMensaje(3,R3)
    EnviarMensaje(4,R4)
  fin
  
areas
  areaCompartida: AreaC (11,11,11,11)
  areaCoordinador: AreaP (1,1,1,1)
  av4: AreaP (4,1,4,100)
  av6: AreaP (6,1,6,100)
  av8: AreaP (8,1,8,100)
  av10: AreaP (10,1,10,100)
  
robots
  robot papelero
  variables
    calleAct: numero
    avAct: numero
    seguir: boolean
    id: numero
  comenzar
    seguir:= V
    RecibirMensaje(id,coordinador)
    mientras(seguir) & (PosCa < 100)   {importante, para que no caiga de la ciudad}
      calleAct:= PosCa
      avAct:= PosAv
      BloquearEsquina(11,11)
      Pos(11,11)
      si(HayPapelEnLaEsquina)
        tomarPapel
        Pos(avAct,calleAct)
        LiberarEsquina(11,11)
        depositarPapel
        mover
      sino
        Pos(avAct,calleAct)
        EnviarMensaje(id,coordinador)
        EnviarMensaje(calleAct,coordinador)  {si aca enviaba posca, me daba error}
        LiberarEsquina(11,11)
        seguir:= F
    si(PosCa = 100)
      EnviarMensaje(id,coordinador)
      EnviarMensaje(PosCa,coordinador)      
  fin
  
  robot robotCoordinador
  variables
    quien: numero
    ultimo: numero
    idMax1: numero
    calle, calleMax1: numero
  comenzar
    enviarIDs
    calleMax1:= -1
    repetir 4
      RecibirMensaje(quien,*)
      si(quien = 1)
        RecibirMensaje(calle,R1)
      sino
        si(quien = 2)
          RecibirMensaje(calle,R2)
        sino
          si(quien = 3)
            RecibirMensaje(calle,R3)
          sino
            si(quien = 4)
              RecibirMensaje(calle,R4)    
      si(calle > calleMax1)
        calleMax1:= calle
        idMax1:= quien
    Informar("Gano el Rob. num. ",idMax1)   {NO hace falta controlar q sea el 1ro, porque solo se actualiza cuando}
  fin                                       {aumenta la calle max (es decir el primero en aumentar)}
  
variables
  R1: papelero
  R2: papelero
  R3: papelero
  R4: papelero
  coordinador: robotCoordinador      
comenzar
  AsignarArea(R1, av4)
  AsignarArea(R2, av6)
  AsignarArea(R3, av8)
  AsignarArea(R4, av10)
  AsignarArea(R1, areaCompartida)
  AsignarArea(R2, areaCompartida)
  AsignarArea(R3, areaCompartida)
  AsignarArea(R4, areaCompartida)
  AsignarArea(coordinador, areaCoordinador)
  Iniciar(coordinador, 1,1)
  Iniciar(R1, 4,1)
  Iniciar(R2, 6,1)
  Iniciar(R3, 8,1)
  Iniciar(R4, 10,1)
fin