programa PRACTICA_4_1
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,R1)
    EnviarMensaje(2,R2)
    EnviarMensaje(3,R3)
  fin
  
  proceso enviarDatos(E id: numero; E floresAle: numero; E avAct: numero; E calleAct: numero)
  comenzar
    EnviarMensaje(id,servidor)
    EnviarMensaje(floresAle,servidor)
    EnviarMensaje(avAct,servidor)
    EnviarMensaje(calleAct,servidor)
  fin
  
  proceso tomarFlores(E floresAle: numero; ES flores: numero)
  comenzar
    repetir floresAle
      tomarFlor
      flores:= flores + 1
  fin
  
  proceso avanzarDepositandoFlores(E flores: numero)
  comenzar
    repetir flores
      depositarFlor 
      si(PosCa < 100)                           
        mover
  fin
  
  proceso depositarAdelanteYvolver(E av: numero; E calle: numero; E cant: numero)
  comenzar
    Pos(av,calle)
    repetir cant
      depositarFlor
    Pos(100,100)
  fin
  
areas
  area1: AreaPC (1,1,1,100)
  area2: AreaPC (2,1,2,100)
  area3: AreaPC (3,1,3,100)
  areaServidor: AreaP(100,100,100,100)
  
robots
  robot cliente
  variables
    floresAle: numero
    id: numero
    avAct, calleAct: numero
    ACK: boolean
    flores: numero
  comenzar
    avAct:= PosAv
    RecibirMensaje(id,servidor)
    mientras(PosCa < 100)
      calleAct:= PosCa + 1
      Random(floresAle,1,4)
      enviarDatos(id,floresAle,avAct,calleAct)
      RecibirMensaje(ACK,servidor)  {es el v q envia el servidor cuando termina}
      mover
      flores:= 0
      tomarFlores(floresAle,flores)
      Pos(avAct,calleAct - 1)  
      avanzarDepositandoFlores(flores)
    EnviarMensaje(id,servidor)
    EnviarMensaje(0,servidor)    {enviar mensaje de que termino (flores)}
  fin
  
  robot robotServidor
  variables
    id: numero
    quien: numero
    cant: numero
    av: numero
    calle: numero
    terminados: numero
    a: numero
  comenzar
    a:= 1
    enviarIDs
    terminados:= 0
    mientras(terminados < 3)
      RecibirMensaje(quien,*)
      si(quien = 1)
        RecibirMensaje(cant,R1)
        si(cant <> 0)             {nunca seria 0 cant. porque es de 1 a 4}
          RecibirMensaje(av,R1)
          RecibirMensaje(calle,R1)
          depositarAdelanteYvolver(av,calle,cant)
          EnviarMensaje(V,R1)
        sino
          terminados:= terminados + 1   
      sino
        si(quien = 2)
          RecibirMensaje(cant,R2)
          si(cant <> 0)
            RecibirMensaje(av,R2)
            RecibirMensaje(calle,R2)
            depositarAdelanteYvolver(av,calle,cant)
            EnviarMensaje(V,R2)
          sino
            terminados:= terminados + 1
        sino
          si(quien = 3)
            RecibirMensaje(cant,R3)
            si(cant <> 0)
              RecibirMensaje(av,R3)
              RecibirMensaje(calle,R3)
              depositarAdelanteYvolver(av,calle,cant)
              EnviarMensaje(V,R3)
            sino
              terminados:= terminados + 1         
    Informar(a)
  fin
  
variables
  servidor: robotServidor
  R1: cliente
  R2: cliente
  R3: cliente
comenzar
  AsignarArea(R1, area1)
  AsignarArea(R2, area2)
  AsignarArea(R3, area3)
  AsignarArea(servidor, area1)
  AsignarArea(servidor, area2)
  AsignarArea(servidor, area3)
  AsignarArea(servidor, areaServidor)
  Iniciar(servidor, 100,100)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,1)
  Iniciar(R3, 3,1)
fin
