programa PRACTICA_4_3
procesos
  proceso enviarIDs
  comenzar
    EnviarMensaje(1,R1)
    EnviarMensaje(2,R2)
    EnviarMensaje(3,R3)
  fin
  
  proceso juntarPapeles(ES papeles: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      papeles:= papeles + 1
  fin
  
  proceso realizarEtapa(ES papeles: numero)
  comenzar
    repetir 5
      juntarPapeles(papeles)
      si(PosCa < 100)       {importante para no caerse, controlar cuando el robot se mueve}
        mover
  fin
  
  
areas
  areaInicio: AreaP (4,1,4,1)
  areaAvenida1: AreaP (1,1,1,100)
  areaAvenida2: AreaP (2,1,2,100)
  areaAvenida3: AreaP (3,1,3,100)
  
robots
  robot papelero
  variables
    papeles: numero
    ID: numero
    aviso: boolean
    etapa : numero
  comenzar
    papeles := 0
    etapa := 0
    RecibirMensaje(ID,coordinador)
    repetir 20                                 {una etapa tiene 5 esquinas y son 100 esquinas}
      realizarEtapa(papeles)                    {todos arrancan al mismo tiempo}
      etapa := etapa + 1                        {arranca en la etapa 1}
       {Informar("soy el rob. num.",ID)   }
       {Informar("termine la etap.",etapa)}
      si(ID = 1)
        RecibirMensaje(aviso,R2) {el robot 1 espera a los otros2}
        RecibirMensaje(aviso,R3)
        EnviarMensaje(V,R2)
        EnviarMensaje(V,R3)
      sino
        si(ID = 2)
          EnviarMensaje(V,R1)
          RecibirMensaje(aviso,R1)
        sino {id 3}
          EnviarMensaje(V,R1)
          RecibirMensaje(aviso,R1) {los r. esperan el aviso de los demas para seguir}
  fin

  robot robotCoordinador
  comenzar
    enviarIDs
  fin
  
variables
  R1: papelero
  R2: papelero
  R3: papelero
  coordinador: robotCoordinador
comenzar
  AsignarArea(coordinador, areaInicio)
  AsignarArea(R1, areaAvenida1)
  AsignarArea(R2, areaAvenida2)
  AsignarArea(R3, areaAvenida3)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,1)
  Iniciar(R3, 3,1)
  Iniciar(coordinador, 4,1)
fin
